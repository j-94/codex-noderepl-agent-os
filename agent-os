function stdinText() {
  if (process.stdin.isTTY) {
    throw new Error('new file content must be piped on stdin');
  }
  return fs.readFileSync(0, 'utf8');
}

function splitLines(text) {
  const lines = String(text).split('\n');
  if (lines.length && lines[lines.length - 1] === '') lines.pop();
  return lines;
}

function unifiedReplaceDiff(filePath, oldText, newText) {
  const oldLines = splitLines(oldText);
  const newLines = splitLines(newText);
  const header = [
    `--- a/${filePath}`,
    `+++ b/${filePath}`,
    `@@ -1,${Math.max(oldLines.length, 1)} +1,${Math.max(newLines.length, 1)} @@`,
  ];
  return `${header.concat(oldLines.map((line) => `-${line}`), newLines.map((line) => `+${line}`)).join('\n')}\n`;
}

function patchArtifact(intent, filePath, newText) {
  if (!filePath) throw new Error('target file path is required');
  const current = fs.existsSync(filePath) ? fs.readFileSync(filePath, 'utf8') : '';
  const t = trace(intent);
  const diff = unifiedReplaceDiff(filePath, current, newText);
  return {
    kind: 'agent_os.patch_artifact.v0',
    trace: t,
    target_path: filePath,
    materialized_target: false,
    diff,
    bytes: Buffer.byteLength(diff),
    rollback: 'No target file was changed.',
    apply_boundary: 'Apply this diff with an explicit executor after admission; this command only emits the artifact.',
    claim_boundary: 'Patch artifact generation is not target-file mutation.',
  };
}

function exportPatch(intent, filePath, outputPath, newText) {
  if (!outputPath) throw new Error('output patch path is required');
  const artifact = patchArtifact(intent, filePath, newText);
  fs.writeFileSync(outputPath, artifact.diff, 'utf8');
  return {
    kind: 'agent_os.patch_export_receipt.v0',
    trace: artifact.trace,
    target_path: filePath,
    output_path: outputPath,
    bytes: artifact.bytes,
    materialized_target: false,
    rollback: `rm ${JSON.stringify(outputPath)}`,
    claim_boundary: 'Exported a patch artifact only; target file was not modified.',
  };
}

function* walkJsonl(dir) {
  if (!fs.existsSync(dir)) return;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const fullPath = path.join(dir, entry.name);
    if (entry.isDirectory()) yield* walkJsonl(fullPath);
    if (entry.isFile() && entry.name.endsWith('.jsonl')) yield fullPath;
  }
}

function addEvent(ev, item) {
  const payload = item.payload || {};
  const type = payload.type;
  const name = payload.name || '';
  const raw = JSON.stringify(payload).toLowerCase();
  ev.total += 1;
  if (type === 'function_call' || type === 'custom_tool_call' || type === 'web_search_call' || type === 'tool_search_call') ev.tools += 1;
  if (name === 'exec_command' || raw.includes('exec_command')) ev.shell += 1;
  if (name === 'apply_patch' || type === 'patch_apply_end' || raw.includes('apply_patch')) ev.patch += 1;
  if (name === 'apply_patch' || type === 'patch_apply_end' || raw.includes('fs.write') || raw.includes('git push') || raw.includes('git commit')) ev.write += 1;
  if (type === 'turn_aborted' || raw.includes('turn_aborted')) ev.abort += 1;
}

function ingestCodex(root) {
  const sessionsDir = path.join(root, 'sessions');
  const turns = [];
  for (const file of walkJsonl(sessionsDir)) {
    let session = 'unknown';
    let current = null;
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      if (!line.trim()) continue;
      let item;
      try {
        item = JSON.parse(line);
      } catch {
        continue;
      }
      if (item.type === 'session_meta') {
        session = item.payload && item.payload.id ? item.payload.id : session;
        continue;
      }
      const payload = item.payload || {};
      let text = '';
      if (item.type === 'event_msg' && payload.type === 'user_message') text = payload.message || '';
      if (item.type === 'response_item' && payload.role === 'user') {
        text = (payload.content || []).map((part) => part.text || '').join('\n');
      }
      text = text.replace(/\s+/g, ' ').trim();
      if (text && text.length < 3000) {
        if (current && current.intent.text === text) continue;
        if (current) turns.push(current);
        current = {
          session,
          file,
          intent: { text, source: 'codex_rollout' },
          events: { total: 0, tools: 0, shell: 0, patch: 0, write: 0, abort: 0 },
        };
        continue;
      }
      if (current) addEvent(current.events, item);
    }
    if (current) turns.push(current);
  }

  const relevantWords = [
    'codex',
    'agent',
    'agents',
    'memory',
    'inmem',
    'tensor',
    'vector',
    'route',
    'proof',
    'prove',
    'github',
    'repo',
    'commit',
    'files',
    'tool',
    'history',
    'artifact',
    'frontier',
    'proceed',
    'runtime',
    'trace',
    'token',
    'speed',
    'model',
    'bvt',
    'rtk',
    'nstar',
    'meta3',
    'meta5',
    'swe',
    'receipt',
    'packet',
  ];
  const seen = new Set();
  return turns
    .filter((turn) => {
      const key = `${turn.session}:${crypto.createHash('sha256').update(turn.intent.text).digest('hex').slice(0, 12)}`;
      if (seen.has(key)) return false;
      seen.add(key);
      return hasAny(words(turn.intent.text), relevantWords);
    })
    .map((turn) => {
      const row = trace(turn.intent.text);
      row.intent.source = turn.intent.source;
      row.intent.session = turn.session;
      row.receipt.observed_tools = turn.events.tools;
      row.receipt.observed_shell = turn.events.shell;
      row.receipt.observed_patch = turn.events.patch;
      row.receipt.observed_write = turn.events.write;
      row.receipt.aborted = turn.events.abort;
      row.receipt.outcome = turn.events.write && row.route.predicted !== 'ops_tape_hold'
        ? 'prior_write_after_non_effect_intent'
        : turn.events.write
          ? 'observed_effectful_turn'
          : row.receipt.outcome;
      row.training.prior_violation = row.receipt.outcome === 'prior_write_after_non_effect_intent';
      row.training.reward = row.training.prior_violation ? -1 : row.training.reward;
      row.training.split = crypto.createHash('sha256').update(turn.intent.text).digest('hex').charCodeAt(0) % 5 === 0 ? 'heldout' : 'train';
      return row;
    });
}

function routeEntropy(records) {
  const counts = {};
  for (const record of records) counts[record.route.predicted] = (counts[record.route.predicted] || 0) + 1;
  const total = records.length || 1;
  let entropy = 0;
  for (const count of Object.values(counts)) {
    const p = count / total;
    entropy -= p * Math.log2(p);
  }
  return { entropy_bits: Number(entropy.toFixed(4)), counts };
}

function metrics(records) {
  const entropy = routeEntropy(records);
  const totals = records.reduce(
    (acc, record) => {
      acc.records += 1;
      acc.heldout += record.training.split === 'heldout' ? 1 : 0;
      acc.observed_write += record.receipt.observed_write ? 1 : 0;
      acc.prior_violation += record.training.prior_violation ? 1 : 0;
      acc.unsafe_admit += record.receipt.unsafe_admit ? 1 : 0;
      acc.ops_hold += record.route.predicted === 'ops_tape_hold' ? 1 : 0;
      return acc;
    },
    { records: 0, heldout: 0, observed_write: 0, prior_violation: 0, unsafe_admit: 0, ops_hold: 0 },
  );
  return {
    kind: 'agent_os.metrics.v0',
    ...totals,
    route_entropy_bits: entropy.entropy_bits,
    route_counts: entropy.counts,
    unsafe_admit_frequency: totals.records ? totals.unsafe_admit / totals.records : 0,
    claim_boundary: 'Metrics describe observed trace rows; they do not prove general policy quality.',
  };
}

function train(records) {
  const trainRows = records.filter((record) => record.training.split !== 'heldout');
  const heldoutRows = records.filter((record) => record.training.split === 'heldout');
  const labels = ['control_kernel', 'search_memory', 'candidate_select', 'test_gate', 'ops_tape_hold'];
  const featureNames = ['effect', 'question', 'github', 'inmem', 'search', 'prove', 'future', 'compress', 'meta', 'proceed'];
  const weights = Object.fromEntries(labels.map((label) => [label, Object.fromEntries(featureNames.map((feature) => [feature, 0]))]));
  for (const record of trainRows) {
    const f = record.packet.typed_ast.intent_flags;
    for (const feature of featureNames) weights[record.route.predicted][feature] += f[feature] || 0;
  }
  function predict(record) {
    const f = record.packet.typed_ast.intent_flags;
    let best = labels[0];
    let bestScore = -Infinity;
    for (const label of labels) {
      const score = featureNames.reduce((sum, feature) => sum + weights[label][feature] * (f[feature] || 0), 0);
      if (score > bestScore) {
        best = label;
        bestScore = score;
      }
    }
    return best;
  }
  const heldout = heldoutRows.map((record) => ({
    trace_id: record.trace_id,
    expected: record.route.predicted,
    predicted: predict(record),
    ok: predict(record) === record.route.predicted,
  }));
  return {
    kind: 'agent_os.train_receipt.v0',
    model: 'count_weighted_route_classifier',
    train_records: trainRows.length,
    heldout_records: heldoutRows.length,
    heldout_ok: heldout.filter((row) => row.ok).length,
    heldout_total: heldout.length,
    weights,
    heldout: heldout.slice(0, 20),
    claim_boundary: 'Tiny in-memory learner proves training flow, not production route quality.',
  };
}

function loadRecords(root) {
  return ingestCodex(root);
}

function exportTrace(intent, outputPath) {
  if (!outputPath) throw new Error('output path is required');
  const body = `${JSON.stringify(trace(intent), null, 2)}\n`;
  fs.writeFileSync(outputPath, body, 'utf8');
  return {
    kind: 'agent_os.export_receipt.v0',
    output_path: outputPath,
    bytes: Buffer.byteLength(body),
    rollback: `rm ${JSON.stringify(outputPath)}`,
    claim_boundary: 'Exported one trace artifact; no executor action was admitted.',
  };
}

