function assertEqual(name, actual, expected) {
  if (actual !== expected) {
    throw new Error(`${name}: expected ${expected}, got ${actual}`);
  }
}

function selftest() {
  const cases = [
    {
      intent: 'find the prior tensor routing artifact',
      route: 'search_memory',
      gate: 'virtual',
    },
    {
      intent: 'can we add gh tools inmem?',
      route: 'candidate_select',
      gate: 'virtual',
    },
    {
      intent: 'evaluate SWE correctness with held-out tests',
      route: 'test_gate',
      gate: 'virtual',
    },
    {
      intent: 'commit directly from in-memory state',
      route: 'ops_tape_hold',
      gate: 'hold',
    },
    {
      intent: 'update a config file',
      route: 'ops_tape_hold',
      gate: 'hold',
    },
    {
      intent: 'what should we do next to reduce token spend',
      route: 'control_kernel',
      gate: 'virtual',
    },
  ];
  const rows = cases.map((item) => {
    const result = trace(item.intent);
    assertEqual(`${item.intent} route`, result.route.predicted, item.route);
    assertEqual(`${item.intent} gate`, result.route.admitted, item.gate);
    assertEqual(`${item.intent} executor`, result.route.executor_allowed, false);
    assertEqual(`${item.intent} schema`, result.schema, 'agent_trace_abi.v0');
    assertEqual(`${item.intent} vl`, result.packet.vl, 'VL1');
    return {
      intent: item.intent,
      bitmask: result.packet.bitmask,
      prime_product: result.packet.prime_product,
      route: result.route.predicted,
      gate: result.route.admitted,
    };
  });
  return {
    kind: 'agent_os.selftest_receipt.v0',
    version: VERSION,
    passed: true,
    cases: rows.length,
    rows,
    claim_boundary: 'Selftest covers routing/gating invariants only; it does not prove production autonomy.',
  };
}

function main(argv) {
  const [command, ...rest] = argv;
  try {
    if (!command || command === 'help' || command === '--help' || command === '-h') {
      console.log(usage());
      return;
    }
    if (command === 'version') {
      console.log(VERSION);
      return;
    }
    if (command === 'explain') {
      console.log(JSON.stringify(explain(), null, 2));
      return;
    }
    if (command === 'lineage') {
      console.log(JSON.stringify(lineage(), null, 2));
      return;
    }
    if (command === 'trace') {
      console.log(JSON.stringify(trace(rest.join(' ')), null, 2));
      return;
    }
    if (command === 'plan') {
      console.log(JSON.stringify(patchPlan(rest.join(' ')), null, 2));
      return;
    }
    if (command === 'patch') {
      const filePath = rest.pop();
      console.log(JSON.stringify(patchArtifact(rest.join(' '), filePath, stdinText()), null, 2));
      return;
    }
    if (command === 'patch-export') {
      const outputPath = rest.pop();
      const filePath = rest.pop();
      console.log(JSON.stringify(exportPatch(rest.join(' '), filePath, outputPath, stdinText()), null, 2));
      return;
    }
    if (command === 'export') {
      const outputPath = rest.pop();
      console.log(JSON.stringify(exportTrace(rest.join(' '), outputPath), null, 2));
      return;
    }
    if (command === 'selftest') {
      console.log(JSON.stringify(selftest(), null, 2));
      return;
    }
    if (command === 'ingest') {
      const root = rest[0] || process.env.CODEX_HOME || path.join(process.env.HOME || '.', '.codex-clean');
      const records = loadRecords(root);
      console.log(JSON.stringify({ kind: 'agent_os.ingest_receipt.v0', root, records: records.length, rows: records.slice(0, 10) }, null, 2));
      return;
    }
    if (command === 'metrics') {
      const root = rest[0] || process.env.CODEX_HOME || path.join(process.env.HOME || '.', '.codex-clean');
      console.log(JSON.stringify(metrics(loadRecords(root)), null, 2));
      return;
    }
    if (command === 'train') {
      const root = rest[0] || process.env.CODEX_HOME || path.join(process.env.HOME || '.', '.codex-clean');
      console.log(JSON.stringify(train(loadRecords(root)), null, 2));
      return;
    }
    throw new Error(`unknown command: ${command}`);
  } catch (error) {
    console.error(`agent-os: ${error.message}`);
    process.exitCode = 1;
  }
}

if (require.main === module) main(process.argv.slice(2));

module.exports = {
  DIMS,
  VERSION,
  trace,
  patchPlan,
  patchArtifact,
  exportPatch,
  explain,
  lineage,
  selftest,
  ingestCodex,
  metrics,
  train,
};
