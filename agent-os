#!/usr/bin/env node
'use strict';

const { init, readMem, run, snapshot, step } = require('./src/core');
const { gate, memexec, memfs } = require('./src/tools');
const repl = require('./src/repl');

function print(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

function selftest() {
  const machine = run(init(), [
    memfs.write('note.txt', 'hello'),
    memfs.read('note.txt'),
    memexec.plan(['npm', 'test']),
    gate.effect(['fs.write', 'real.txt']),
  ]);
  return {
    ok: machine.halted === true,
    head: machine.head,
    virtualWrite: readMem(machine, 'note.txt').value === 'hello',
    receipts: machine.receipts.length,
    realEffectsBlocked: machine.mem.length === 1,
  };
}

function main(argv) {
  const [command, ...args] = argv;
  if (!command || command === 'help') {
    process.stdout.write([
      'codex-tape',
      '',
      './agent-os selftest',
      './agent-os step write <path> <bytes>',
      './agent-os step read <path>',
      './agent-os step plan <cmd...>',
      './agent-os repl',
      '',
    ].join('\n'));
    return;
  }
  if (command === 'selftest') return print(selftest());
  if (command === 'repl') return repl.start();
  if (command === 'step') {
    const event = repl.parse(args.join(' '));
    return print(snapshot(step(init(), event)));
  }
  throw new Error(`unknown command: ${command}`);
}

if (require.main === module) {
  try {
    main(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exitCode = 1;
  }
}

module.exports = {
  selftest,
};
