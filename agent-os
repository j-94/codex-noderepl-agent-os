#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const VERSION = '0.1.0';

const DIMS = [
  ['answer', 2n],
  ['search', 3n],
  ['code', 5n],
  ['prove', 7n],
  ['publish', 11n],
  ['effect', 13n],
  ['filesystem', 17n],
  ['git', 19n],
  ['github', 23n],
  ['rollback', 29n],
  ['evidence', 31n],
  ['claim_boundary', 37n],
  ['receipt', 41n],
  ['benchmark', 43n],
  ['memfs', 47n],
  ['raw_history', 53n],
  ['token_saving', 59n],
  ['swe_proof', 61n],
  ['ops_tape', 67n],
  ['candidate_select', 71n],
  ['test_gate', 73n],
  ['control_kernel', 79n],
  ['tensor_route', 83n],
];

const INDEX = Object.fromEntries(DIMS.map(([name], index) => [name, index]));
const PRIME = Object.fromEntries(DIMS);

function words(text) {
  return String(text).toLowerCase().match(/[a-z0-9]+/g) || [];
}

function hasAny(tokens, candidates) {
  return candidates.some((candidate) => tokens.includes(candidate));
}

function flags(intent) {
  const tokens = words(intent);
  const lower = String(intent).toLowerCase();
  return {
    effect: Number(
      hasAny(tokens, [
        'write',
        'update',
        'change',
        'create',
        'edit',
        'fix',
        'patch',
        'commit',
        'push',
        'delete',
        'materialize',
        'run',
        'install',
        'deploy',
        'proceed',
        'make',
      ]) && !lower.includes('inmem only'),
    ),
    question: Number(hasAny(tokens, ['can', 'could', 'should', 'what', 'how', 'why', 'is', 'are', 'does'])),
    github: Number(hasAny(tokens, ['github', 'repo', 'commit', 'push', 'pr', 'gh'])),
    inmem: Number(hasAny(tokens, ['inmem', 'memfs', 'memory', 'tensor', 'vector', 'vl1', 'bits', 'packet'])),
    search: Number(
      hasAny(tokens, ['find', 'search', 'look', 'history', 'artifact', 'prior', 'where', 'explain', 'understand', 'remember', 'traces']),
    ),
    prove: Number(hasAny(tokens, ['prove', 'proof', 'test', 'benchmark', 'eval', 'correctness', 'receipt', 'working'])),
    future: Number(hasAny(tokens, ['ideas', 'frontier', 'alternatives', 'lateral', 'next', 'plan', 'tools'])),
    compress: Number(hasAny(tokens, ['token', 'spend', 'speed', 'smaller', 'compact', 'toml', 'json', 'language'])),
    meta: Number(hasAny(tokens, ['codex', 'agent', 'agents', 'bvt', 'rtk', 'nstar', 'meta3', 'meta5', 'swe', 'model'])),
    proceed: Number(hasAny(tokens, ['proceed', 'go', 'make'])),
  };
}

function routeFromFlags(f) {
  if ((f.effect && !f.question) || (f.github && f.effect)) {
    return {
      tensor_family: 'intervention',
      predicted: 'ops_tape_hold',
      admitted: 'hold',
      executor_allowed: false,
    };
  }
  if (f.prove) {
    return {
      tensor_family: 'intervention',
      predicted: 'test_gate',
      admitted: 'virtual',
      executor_allowed: false,
    };
  }
  if (f.compress) {
    return {
      tensor_family: 'compression',
      predicted: 'control_kernel',
      admitted: 'virtual',
      executor_allowed: false,
    };
  }
  if (f.future || (f.question && f.github)) {
    return {
      tensor_family: 'future',
      predicted: 'candidate_select',
      admitted: 'virtual',
      executor_allowed: false,
    };
  }
  if (f.search) {
    return {
      tensor_family: 'memory',
      predicted: 'search_memory',
      admitted: 'virtual',
      executor_allowed: false,
    };
  }
  return {
    tensor_family: 'compression',
    predicted: 'control_kernel',
    admitted: 'virtual',
    executor_allowed: false,
  };
}

function activeDims(f, route) {
  const active = ['claim_boundary', 'receipt', 'tensor_route'];
  if (route.predicted === 'control_kernel') active.push('answer', 'control_kernel');
  if (route.predicted === 'search_memory') active.push('answer', 'search', 'raw_history', 'evidence');
  if (route.predicted === 'candidate_select') active.push('answer', 'candidate_select', 'evidence');
  if (route.predicted === 'test_gate') active.push('prove', 'benchmark', 'evidence', 'test_gate');
  if (route.predicted === 'ops_tape_hold') active.push('effect', 'rollback', 'evidence', 'ops_tape');
  if (f.github) active.push('github', 'git', 'publish');
  if (f.inmem) active.push('memfs');
  if (f.compress) active.push('token_saving');
  return [...new Set(active)];
}

function encode(active) {
  let bitmask = 0n;
  let primeProduct = 1n;
  for (const dim of active) {
    bitmask |= 1n << BigInt(INDEX[dim]);
    primeProduct *= PRIME[dim];
  }
  return {
    vl: 'VL1',
    bitmask: `0x${bitmask.toString(16)}`,
    prime_product: primeProduct.toString(),
    active_dims: active,
    vector: DIMS.map(([dim]) => (active.includes(dim) ? 1 : 0)),
  };
}

function trace(intent) {
  const intentText = String(intent || '').trim();
  if (!intentText) throw new Error('intent is required');
  const f = flags(intentText);
  const route = routeFromFlags(f);
  const packet = encode(activeDims(f, route));
  const opTape = route.predicted === 'ops_tape_hold' ? [{ op: 'hold', reason: 'effect_requires_admission' }] : [];
  return {
    trace_id: `agent-trace://${crypto.createHash('sha256').update(intentText).digest('hex').slice(0, 16)}`,
    schema: 'agent_trace_abi.v0',
    intent: {
      text: intentText,
      source: 'cli',
    },
    packet: {
      ...packet,
      typed_ast: {
        kind: 'control.transition.v0',
        tensor_family: route.tensor_family,
        intent_flags: f,
      },
      op_tape: opTape,
    },
    route,
    receipt: {
      observed_tools: 0,
      observed_shell: 0,
      observed_patch: 0,
      observed_write: 0,
      aborted: 0,
      unsafe_admit: false,
      repair_count: 0,
      time_ms: null,
      token_cost: null,
      outcome: route.admitted === 'hold' ? 'effect_held_before_executor' : 'virtual_control_packet',
    },
    training: {
      target_route: route.predicted,
      target_gate: route.admitted,
      target_executor_allowed: false,
      reward: route.admitted === 'hold' ? 0.4 : 0.1,
      prior_violation: false,
    },
  };
}

function patchPlan(intent) {
