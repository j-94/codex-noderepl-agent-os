{
  "schema": "agent_os.repo_route.v0",
  "route_id": "repo.session_entry.transition_proxy.v0",
  "name": "Repository Session Entry Transition Proxy",
  "status": "active",
  "scope": {
    "workspace": "/Users/jobs/Documents/New project",
    "repository": "j-94/codex-noderepl-agent-os"
  },
  "intent_class": [
    "state_question",
    "operation_question",
    "control_question",
    "system_memory_question",
    "prior_work_question"
  ],
  "trigger_examples": [
    "what state are we in",
    "how should you operate",
    "what is this in relation",
    "look at previous chats for how to operate",
    "fix the control route"
  ],
  "controller": {
    "kind": "in_memory_transition_proxy",
    "call": "TP(intent, recovered_state?, op?, gate?)",
    "always_available": true,
    "not_controller": [
      "filesystem",
      "shell",
      "repo_scan",
      "github",
      "history_merge_distiller",
      "operator_workbench_vm",
      "agent_os_cli"
    ]
  },
  "route": [
    {
      "step": "recover",
      "object": "project AGENTS session-entry state",
      "policy": "use as compact recovered state for ordinary control questions"
    },
    {
      "step": "compile",
      "object": "transition.packet.v0",
      "policy": "convert user intent into compact in-memory packet before tools or prose"
    },
    {
      "step": "select",
      "object": "answer-card | patch-card | WorkManifest | ControlPacket",
      "policy": "choose the smallest useful generation object"
    },
    {
      "step": "gate",
      "object": "rollback + evidence + claim_boundary + receipt preview",
      "policy": "hold effects unless explicit admission is present"
    },
    {
      "step": "render",
      "object": "compact response or admitted effect request",
      "policy": "render prose as a view of the packet, not as the control state"
    }
  ],
  "fallback_sensors": [
    "routes/session-entry.route.json",
    "AGENTS.md",
    "README.md",
    "/Users/jobs/.codex-clean/control-delta.standard-codex.json",
    "/Users/jobs/.codex-clean/AGENTS.md",
    "/Users/jobs/Desktop/history-merge-distiller",
    "codex://threads/<id>"
  ],
  "effect_boundary": {
    "default": "hold",
    "requires": [
      "explicit_user_admission",
      "rollback",
      "evidence",
      "claim_boundary",
      "receipt"
    ],
    "materialization_backend": "executor or tool selected after TP gate"
  },
  "claim_boundary": "This route makes the repository carry the session-entry control contract. It is not mechanical enforcement, production autonomy, SWE proof, or proof of a sealed effect proxy."
}
